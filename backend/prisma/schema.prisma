// ========================
//  GENERATOR & DATASOURCE
// ========================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}



// ========================
//  TENANT
// ========================
model Tenant {
  id                   String             @id @default(cuid())
  name                 String
  email                String             @unique
  profilePic           String?
  password             String
  role                 Role               @default(ADMIN)

  domain               String?            @unique

  // Stripe
  subscriptionStatus   SubscriptionStatus @default(INACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  employees            Employee[]
  departments          Department[]
  projects             Project[]
  leaves               Leave[]
  tasks                Task[]
  inviteTokens         InviteToken[]
  automationRules      AutomationRule[]
  notifications        Notification[]
}


// ========================
//  INVITE TOKEN
// ========================
model InviteToken {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  role      Role
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  sentById  String?  // employeeId of manager who sent invite (null if admin sent)

  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}



// ========================
//  EMPLOYEE (USER)
// ========================
model Employee {
  id                String   @id @default(cuid())

  // LOGIN
  email             String   @unique
  profilePic        String?
  password          String?
  role              Role     @default(EMPLOYEE)

  // Profile
  firstName         String
  lastName          String?
  phone             String?
  dateOfBirth       DateTime?
  gender            Gender?  @default(OTHER)
  position          String?

  // Initial Setup
  setupToken        String?
  setupTokenExpiry  DateTime?

  // Employment
  salary            Float?
  dateOfJoining     DateTime?
  employmentType    EmploymentType   @default(FULL_TIME)
  status            EmploymentStatus @default(ACTIVE)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  departmentId      String?
  tenantId          String

  tenant            Tenant     @relation(fields: [tenantId], references: [id])
  department        Department? @relation(fields: [departmentId], references: [id])

  // Employee working on multiple projects
  projects           Project[]

  // Employee can manage MULTIPLE projects (UPDATED)
  projectsManaged    Project[] @relation("ProjectManagerEmployee")

  // Leaves
  leaves             Leave[]

  // Tasks
  tasksAssigned      Task[] @relation("TaskAssignee")
  tasksCreated       Task[] @relation("TaskCreator")

  leavesManaged      Leave[]    @relation("LeaveManager")
  leavesApproved     Leave[]    @relation("LeaveHR")

  // Notifications
  notifications      Notification[]

  // Comments
  comments           TaskComment[] @relation("CommentAuthor")
}



// ========================
//  PROJECT  (Many-to-Many + Multi Manager Support)
// ========================
model Project {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  client      String
  description String?
  status      Status @default(ONGOING)
  deadline    DateTime?

  // Manager CAN now manage multiple projects → REMOVED @unique
  managerId   String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant  @relation(fields: [tenantId], references: [id])

  // Multiple employees working in this project
  members     Employee[]

  // Manager relation → MULTIPLE PROJECT SUPPORT
  manager     Employee @relation("ProjectManagerEmployee", fields: [managerId], references: [id])
  rooms       Room[]
  tasks       Task[]
}



// ========================
//  DEPARTMENT
// ========================
model Department {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  employees Employee[]
}



// ========================
//  LEAVE
// ========================
model Leave {
  id            String       @id @default(cuid())
  tenantId      String
  employeeId    String

  managerId     String? 
  hrId          String? 

  type          LeaveType
  reason        String?

  startDate     DateTime
  endDate       DateTime

  appliedAt     DateTime  @default(now())
  decisionAt    DateTime?

  managerStatus LeaveStatus  @default(PENDING)
  hrStatus      LeaveStatus  @default(PENDING)
  status        LeaveStatus  @default(PENDING)
  attachment    String?

  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  employee      Employee  @relation(fields: [employeeId], references: [id])

  manager       Employee?   @relation("LeaveManager", fields: [managerId], references: [id])
  hr            Employee?   @relation("LeaveHR", fields: [hrId], references: [id])
}



// ========================
//  TASK
// ========================
model Task {
  id            String     @id @default(cuid())
  tenantId      String
  title         String
  description   String?
  priority      TaskPriority @default(MEDIUM)
  status        TaskStatus   @default(TODO)
  dueDate       DateTime?

  assigneeId    String
  creatorId     String
  projectId     String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  assignee      Employee  @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator       Employee  @relation("TaskCreator", fields: [creatorId], references: [id])
  project       Project?  @relation(fields: [projectId], references: [id])
  comments      TaskComment[]
}

// ========================
//  TASK COMMENT
// ========================
model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  content   String
  mentions  String[] // array of employeeIds mentioned

  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    Employee @relation("CommentAuthor", fields: [authorId], references: [id])
}



// ========================
//  NOTIFICATION
// ========================
model Notification {
  id        String   @id @default(cuid())
  userId    String?
  tenantId  String?
  title     String?
  message   String
  type      NotificationType @default(GENERAL)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      Employee? @relation(fields: [userId], references: [id])
  tenant    Tenant?   @relation(fields: [tenantId], references: [id])
}



// ========================
//  WORKFLOW ENGINE
// ========================
model AutomationRule {
  id          String   @id @default(cuid())
  tenantId    String
  trigger     String   // "TASK_OVERDUE", "LEAVE_LONG_DURATION", "PROJECT_DELAYED"
  condition   Json?    // e.g., { "days": 3 }
  action      String   // "NOTIFY_MANAGER", "ESCALATE_HR", "CREATE_MEETING"
  isActive    Boolean  @default(true)

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
}

model EventLog {
  id        String   @id @default(cuid())
  type      String
  payload   Json
  createdAt DateTime @default(now())
}

model Room {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id])
}

// ========================
//  ENUMS
// ========================
enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERN
  CONTRACT
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum Status {
  ONGOING
  PENDING
  CANCELLED
  COMPLETED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  SICK
  VACATION
  CASUAL
  UNPAID
  MATERNITY
  PATERNITY
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum NotificationType {
  GENERAL
  PROJECT
  TASK
  LEAVE
  SALARY
  SYSTEM
  TASK_OVERDUE
  LEAVE_ESCALATION
  MEETING_CREATED
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  CANCELLED
}

